# Copy this to .env and fill in values
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./rop.db
ENVIRONMENT=development
DEBUG=true
# Gemini (optional - system works offline without this)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Demo seed password (change in production)
DEMO_USER_PASSWORD=Demo@12345
